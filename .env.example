# Banco de Dados PostgreSQL (Aiven Cloud ou local)
# Para Aiven Cloud, preencha host/porta/credenciais do servico PostgreSQL e sslmode=require
DB_HOST=seu-servico.aivencloud.com
DB_PORT=27056
DB_USER=avnadmin
DB_PASSWORD=sua-senha-aiven
DB_SSLMODE=require
DB_POOL_MAX=5

# Para usar Postgres local via Docker (docker compose --profile local-db up -d):
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=vitalis
# DB_PASSWORD=vitalis
# DB_SSLMODE=disable
POSTGRES_USER=vitalis
POSTGRES_PASSWORD=vitalis

# Segredo HMAC-SHA256 compartilhado entre os microsserviços e o API Gateway (mínimo 32 bytes / 256 bits)
JWT_SECRET=vitalis-dev-secret-key-256-bits-minimum-length-2026!

# Origens permitidas para CORS no API Gateway (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
GATEWAY_PORT=8080
FRONTEND_PORT=3000

# --- Configuracao Agnostica de IA (servico-ia) ---
# Provedores suportados: openai-compatible (OpenRouter, Ollama, OpenAI, Groq, vLLM) | mock
AI_PROVIDER=openai-compatible
# OpenRouter (padrao):
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-sua-chave-aqui
AI_MODEL=google/gemini-2.5-flash
# Exemplo Ollama local (basta trocar as 3 linhas acima):
# AI_BASE_URL=http://host.docker.internal:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=llama3.1:8b
AI_TIMEOUT_MS=8000
AI_EXTRA_HEADERS_REFERER=https://vitalis.ucsal.br
AI_EXTRA_HEADERS_TITLE="Vitalis Hospitalar"
